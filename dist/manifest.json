{
  "name": "Play LooP",
  "short_name": "Play LooP",
  "description": "Stream and discover your favorite music with Play LooP.",
  "start_url": "/",
  "id": "/",
  "scope": "/",
  "display": "standalone",
  "launch_handler": {
    "client_mode": ["focus-existing", "auto"]
  },
  "protocol_handlers": [
    {
      "protocol": "web+playloop",
      "url": "/?open=%s"
    }
  ],
  "background_color": "#000000",
  "theme_color": "#000000",
  "orientation": "portrait-primary",
  "icons": [
    {
      "src": "/favicon.svg",
      "sizes": "192x192 512x512",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/icon-maskable.svg",
      "sizes": "192x192 512x512",
      "type": "image/svg+xml",
      "purpose": "maskable"
    }
  ]
}
